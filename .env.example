POSTGRES_USER=template
POSTGRES_PASSWORD=template_dev
POSTGRES_DB=template_dev
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=development-only-change-this-32-characters
APP_NAME=Project Template

# Encrypts user-owned provider credentials. Generate with: openssl rand -base64 32
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
OPENAI_ALLOWED_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
FIRECRAWL_CREDIT_LIMIT_MONTHLY=500
OPENAI_IMPORT_LIMIT_MONTHLY=100
# Only enable if the reverse proxy replaces client-supplied forwarded headers.
TRUST_PROXY=false
