generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  properties       Property[]
  searches         Search[]
  imports          PropertyImport[]
  providerSettings ProviderSetting[]
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false) @map("email_verified")
  image            String?
  sessions         Session[]
  accounts         Account[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  role                 UserRole          @default(USER)
  adminManagedByConfig Boolean           @default(false)

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([issuer, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  OTHER
}

enum OperationType {
  SALE
}

enum DecisionStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  VISITED
  OFFER_MADE
  REJECTED
  PURCHASED
}

enum FeatureCategory {
  AREA
  EQUIPMENT
  OTHER
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum ImportStatus {
  QUEUED
  FETCHING
  RENDERING
  EXTRACTING
  READY
  FAILED
}

enum ImportKind {
  STANDARD
  ENHANCEMENT
  CATALOG
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  UNAVAILABLE
}

enum CatalogSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum IntegrationProvider {
  OPENAI
  FIRECRAWL
}

model ProviderSetting {
  id                   String              @id @default(cuid())
  ownerId              String
  owner                User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider             IntegrationProvider
  enabled              Boolean             @default(false)
  model                String?
  credentialCiphertext Bytes?
  credentialIv         Bytes?
  credentialAuthTag    Bytes?
  credentialHint       String?
  validatedAt          DateTime?
  needsAttention       Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([ownerId, provider])
  @@index([ownerId])
}

model Property {
  ownerId             String?
  owner               User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  id                  String            @id @default(cuid())
  sourceProvider      String
  sourceUrl           String?
  sourceListingId     String?
  sourceListingKey    String?
  sourceObservedAt    DateTime
  sourceMetadata      Json
  title               String
  description         String?
  propertyType        PropertyType
  operationType       OperationType     @default(SALE)
  priceAmount         Decimal?          @db.Decimal(14, 2)
  priceCurrency       String?           @db.VarChar(3)
  street              String?
  exteriorNumber      String?
  interiorNumber      String?
  neighborhood        String?
  municipality        String?
  state               String?
  postalCode          String?
  countryCode         String            @default("MX") @db.VarChar(2)
  formattedAddress    String?
  latitude            Decimal?          @db.Decimal(9, 6)
  longitude           Decimal?          @db.Decimal(9, 6)
  landAreaM2          Decimal?          @db.Decimal(10, 2)
  constructionAreaM2  Decimal?          @db.Decimal(10, 2)
  bedrooms            Int?
  bathrooms           Decimal?          @db.Decimal(4, 1)
  parkingSpaces       Int?
  parkingType         String?
  serviceRoom         Boolean?
  propertyAgeYears    Int?
  condition           String?
  orientation         String?
  landUse             String?
  buildingLevels      Int?
  unitFloor           Int?
  maintenanceAmount   Decimal?          @db.Decimal(12, 2)
  maintenanceCurrency String?           @db.VarChar(3)
  technicalSheetQrUrl String?
  agentName           String?
  agentAvatarUrl      String?
  agentPhones         String[]          @default([])
  agentEmail          String?
  officeName          String?
  sourceOfficeId      String?
  publicationStatus   PublicationStatus @default(PUBLISHED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  neighborhoodId      String?
  neighborhoodEntity  Neighborhood?     @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  catalogListing      CatalogListing?
  images              PropertyImage[]
  features            PropertyFeature[]
  imports             PropertyImport[]
  searches            SearchProperty[]

  @@unique([ownerId, sourceUrl])
  @@unique([ownerId, sourceProvider, sourceListingId])
  @@index([ownerId])
  @@index([neighborhoodId])
  @@index([ownerId, publicationStatus])
  @@index([publicationStatus])
  @@index([publicationStatus, neighborhoodId, propertyType])
  @@index([publicationStatus, priceAmount])
  @@index([publicationStatus, constructionAreaM2])
  @@index([publicationStatus, bedrooms])
  @@index([publicationStatus, bathrooms])
}

model PropertyImport {
  ownerId             String
  owner               User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  id                  String                 @id @default(cuid())
  url                 String
  canonicalUrl        String
  status              ImportStatus           @default(QUEUED)
  kind                ImportKind             @default(STANDARD)
  strategy            String?
  provider            String?
  retryCount          Int                    @default(0)
  nextAttemptAt       DateTime               @default(now())
  draftData           Json?
  evidence            Json?
  errorMessage        String?
  inputTokens         Int?
  outputTokens        Int?
  firecrawlCredits    Int                    @default(0)
  processingStartedAt DateTime?
  completedAt         DateTime?
  propertyId          String?
  property            Property?              @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  targets             PropertyImportTarget[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  publishOnReady      Boolean                @default(false)

  @@unique([id, ownerId])
  @@index([status, nextAttemptAt, createdAt])
  @@index([ownerId, canonicalUrl])
  @@index([canonicalUrl])
  @@index([ownerId])
  @@index([ownerId, kind, status])
  @@index([createdAt])
}

model Search {
  id            String                 @id @default(cuid())
  ownerId       String
  owner         User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  nameKey       String
  isPrimary     Boolean                @default(false)
  properties    SearchProperty[]
  importTargets PropertyImportTarget[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([ownerId, nameKey])
  @@unique([id, ownerId])
  @@index([ownerId, updatedAt])
}

model SearchProperty {
  ownerId         String
  searchId        String
  search          Search         @relation(fields: [searchId, ownerId], references: [id, ownerId], onDelete: Cascade)
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  decisionStatus  DecisionStatus @default(NEW)
  isFavorite      Boolean        @default(false)
  rating          Int?
  notes           String?
  visitAt         DateTime?
  rejectionReason String?
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@id([searchId, propertyId])
  @@index([ownerId])
  @@index([propertyId])
  @@index([searchId, decisionStatus])
  @@index([searchId, archivedAt])
  @@index([searchId, isFavorite])
}

model PropertyImportTarget {
  ownerId   String
  importId  String
  import    PropertyImport @relation(fields: [importId, ownerId], references: [id, ownerId], onDelete: Cascade)
  searchId  String
  search    Search         @relation(fields: [searchId, ownerId], references: [id, ownerId], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([importId, searchId])
  @@index([ownerId])
  @@index([searchId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, url])
  @@index([propertyId, sortOrder])
}

model PropertyFeature {
  id         String          @id @default(cuid())
  propertyId String
  category   FeatureCategory
  name       String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, category, name])
  @@index([propertyId])
}

model State {
  id             String          @id
  countryCode    String          @default("MX") @db.VarChar(2)
  name           String
  slug           String
  municipalities Municipality[]
  catalogSources CatalogSource[]

  @@unique([countryCode, slug])
  @@map("states")
}

model Municipality {
  id             String          @id
  stateId        String
  state          State           @relation(fields: [stateId], references: [id], onDelete: Restrict)
  name           String
  slug           String
  neighborhoods  Neighborhood[]
  catalogSources CatalogSource[]

  @@unique([stateId, slug])
  @@index([stateId])
  @@map("municipalities")
}

model Neighborhood {
  id             String          @id
  municipalityId String
  municipality   Municipality    @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  name           String
  slug           String
  properties     Property[]
  catalogSources CatalogSource[]

  @@unique([municipalityId, slug])
  @@index([municipalityId])
  @@map("neighborhoods")
}

model CatalogSource {
  id                   String           @id
  providerKey          String
  name                 String
  discoveryUrl         String
  discoveryConfig      Json
  stateId              String
  state                State            @relation(fields: [stateId], references: [id], onDelete: Restrict)
  municipalityId       String
  municipality         Municipality     @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  neighborhoodId       String
  neighborhood         Neighborhood     @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)
  enabled              Boolean          @default(true)
  lastSuccessfulSyncAt DateTime?
  listings             CatalogListing[]
  syncRuns             CatalogSyncRun[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([enabled])
  @@map("catalog_sources")
}

model CatalogListing {
  propertyId       String        @id
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceId         String
  source           CatalogSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceListingId  String
  sourceModifiedAt DateTime?
  firstSeenAt      DateTime      @default(now())
  lastSeenAt       DateTime      @default(now())
  status           CatalogStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([sourceId, sourceListingId])
  @@index([status, sourceModifiedAt])
  @@map("catalog_listings")
}

model CatalogSyncRun {
  id               String            @id @default(cuid())
  sourceId         String
  source           CatalogSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  scheduledDate    String
  status           CatalogSyncStatus @default(RUNNING)
  discoveredCount  Int               @default(0)
  createdCount     Int               @default(0)
  updatedCount     Int               @default(0)
  unchangedCount   Int               @default(0)
  unavailableCount Int               @default(0)
  failedCount      Int               @default(0)
  retryCount       Int               @default(0)
  errorMessage     String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?

  @@unique([sourceId, scheduledDate])
  @@index([status, startedAt])
  @@map("catalog_sync_runs")
}
